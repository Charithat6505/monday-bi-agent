# Copy this file to .env and fill it in. NEVER commit .env.
MONDAY_API_TOKEN=
GEMINI_API_KEY=

# Optional: skip name-based board lookup by giving the board IDs explicitly
WORK_ORDERS_BOARD_ID=
DEALS_BOARD_ID=

# Optional: leave blank to use monday's "current" API version
MONDAY_API_VERSION=
CACHE_TTL_SECONDS=300
